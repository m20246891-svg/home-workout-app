  "exercises": {
    "mountain-climber": {
      "name": "Скалолаз",
      "instructions": "Прими упор лёжа, руки на ширине плеч. Поочерёдно подтягивай колени к груди в быстром темпе, держа корпус прямым и напряжённым."
    },
    "burpee": {
      "name": "Бёрпи",
      "instructions": "Из положения стоя присядь, поставь руки на пол, прыжком уйди в упор лёжа. Сделай отжимание, прыжком верни ноги к рукам и выпрыгни вверх с хлопком над головой."
    },
    "jump-squat": {
      "name": "Прыжковые приседания",
      "instructions": "Присядь до параллели бёдер с полом, затем выпрыгни вверх с максимальным усилием. Мягко приземляйся на слегка согнутые ноги и сразу уходи в следующий присед."
    },
    "pushup": {
      "name": "Отжимания",
      "instructions": "Прими упор лёжа, ладони на ширине плеч, тело прямое от головы до пят. Опускай грудь к полу, сгибая локти. Выжми себя вверх. Вдох внизу, выдох на подъёме."
    },
    "russian-twist": {
      "name": "Русский твист",
      "instructions": "Сядь на пол, ноги согнуты, стопы на весу. Отклони корпус назад до напряжения пресса. Поворачивай корпус влево и вправо, руки перед грудью."
    },
    "world-greatest-stretch": {
      "name": "Комплексная растяжка",
      "instructions": "Из выпада вперёд опусти руку к полу у передней стопы, затем разверни корпус и вытяни вторую руку вверх. Динамичная растяжка на всё тело. Поменяй сторону."
    },
    "butterfly-stretch": {
      "name": "Бабочка",
      "instructions": "Сядь, стопы вместе, колени разведены в стороны. Возьми стопы руками и мягко надави локтями на колени, опуская их к полу. Спина прямая."
    }
  },
